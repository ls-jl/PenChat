execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE actual ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Golden executable failed: ${result}: ${errors}")
endif()
file(READ "${EXPECTED}" expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Selection/network input/full-resolution gray or mask changed.\n${actual}")
endif()
message(STATUS "32 baseline cases match exactly")
