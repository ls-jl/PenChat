- * @param from 起始索引（包含）
- * @param sep  分隔符
- * @return 拼接后的字符串，如 join({"shu","li","kou"}, 1, "'") => "li'kou"
- */
-std::string join(const std::vector<std::string>& v, uint32_t from, const std::string& sep)
-{
-	std::string s;
-	for (uint32_t i = from; i < v.size(); i++)
-	{
-		if (i > from)
-			s += sep;
-		s += v[i];
-	}
-	return s;
-}
