+// PenChat adapter: read-only selection metadata and explicit user-delta overlay.
+const char* pinyin_ime_candidate_pinyin(pinyin_ime_t* ime, uint32_t index) {
+  return ime && index < ime->candidates.size() ? ime->candidates[index].first.c_str() : nullptr;
+}
+int pinyin_ime_candidate_consumed(pinyin_ime_t* ime, uint32_t index) {
+  if (!ime || index >= ime->candidates.size() || ime->use_k9) return -1;
+  const size_t count = ime->candidates[index].second.size();
+  if (count > ime->segments.size()) return -1;
+  size_t offset = 0;
+  for (size_t i = 0; i < count; ++i) {
+    while (offset < ime->raw_pinyin.size() && ime->raw_pinyin[offset] == '\'') ++offset;
+    offset += ime->segments[i].size();
+  }
+  while (offset < ime->raw_pinyin.size() && ime->raw_pinyin[offset] == '\'') ++offset;
+  return offset <= ime->raw_pinyin.size() ? int(offset) : -1;
+}
+int pinyin_ime_user_word(pinyin_ime_t* ime, const char* py, const char* text, uint32_t frequency) {
+  if (!ime || !py || !text) return PINYIN_IME_ERR_INVALID_ARG;
+  try {
+    const std::string pinyin(py);
+    if (pinyin.empty() || pinyin.size() > 128 || pinyin.find_first_not_of("abcdefghijklmnopqrstuvwxyz'") != std::string::npos)
+      return PINYIN_IME_ERR_INVALID_ARG;
+    std::vector<std::string> segments;
+    const auto word = utf8_to_wstring(text);
+    if (word.empty() || word.size() > 32 || !segmentation(ime, pinyin, 0, segments) || segments.size() != word.size())
+      return PINYIN_IME_ERR_INVALID_ARG;
+    ime->pinyin_to_words[pinyin].insert(word);
+    ime->dictionary[word] = std::max(ime->dictionary[word], frequency);
+    return PINYIN_IME_OK;
+  } catch (...) { return PINYIN_IME_ERR_INVALID_ARG; }
+}
