# Keep patched and system headers separate.
find_path(CurlImpersonate_INCLUDE_DIR edgesearch_curl_namespace.h HINTS "${EDGE_SEARCH_IMPERSONATE_ROOT}" PATH_SUFFIXES include/edge-curl-impersonate include)
find_library(CurlImpersonate_LIBRARY NAMES edge-curl-impersonate HINTS "${EDGE_SEARCH_IMPERSONATE_ROOT}" PATH_SUFFIXES lib lib64 .)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(CurlImpersonate REQUIRED_VARS CurlImpersonate_LIBRARY CurlImpersonate_INCLUDE_DIR)
if(CurlImpersonate_FOUND AND CMAKE_SIZEOF_VOID_P EQUAL 4 AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    file(SHA256 "${CurlImpersonate_LIBRARY}" _edge_impersonate_hash)
    if(_edge_impersonate_hash STREQUAL "c2edd8dca9da3dc2550675b99a091c5a23f8def5476b9b1795226eb6225abad5")
        message(FATAL_ERROR
            "This v2.3.2 ARMHF prebuilt library failed GNU time64 and C++ exception-unwinding checks. "
            "Rebuild libcurl-impersonate with the same target SDK and select that prefix instead. "
            "See README.rst and ROUND-4.txt for the verified source-build path.")
    endif()
endif()
if(CurlImpersonate_FOUND AND NOT TARGET CurlImpersonate::CurlImpersonate)
    if(NOT EXISTS "${CurlImpersonate_INCLUDE_DIR}/edgesearch_curl_namespace.h")
        message(FATAL_ERROR "Native backend requires the private curl namespace. Run tools/namespace_impersonate.py or use the matching Buildroot source package.")
    endif()
    include(CheckCXXSourceCompiles)
    include(CMakePushCheckState)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_INCLUDES "${CurlImpersonate_INCLUDE_DIR}")
    set(CMAKE_REQUIRED_LIBRARIES "${CurlImpersonate_LIBRARY}")
    unset(_EDGE_CURL_NAMESPACE_LINKS CACHE)
    check_cxx_source_compiles("#include <edgesearch_curl_namespace.h>\n#include <curl/curl.h>\nint main() { CURL* p=curl_easy_init(); curl_easy_cleanup(p); return edgesearch_curl_namespace_abi()!=1; }" _EDGE_CURL_NAMESPACE_LINKS)
    cmake_pop_check_state()
    if(NOT _EDGE_CURL_NAMESPACE_LINKS)
        message(FATAL_ERROR "Native library/header namespace mismatch; use a matched private backend prefix")
    endif()
    add_library(CurlImpersonate::CurlImpersonate UNKNOWN IMPORTED)
    set_target_properties(CurlImpersonate::CurlImpersonate PROPERTIES IMPORTED_LOCATION "${CurlImpersonate_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${CurlImpersonate_INCLUDE_DIR}")
endif()
mark_as_advanced(CurlImpersonate_INCLUDE_DIR CurlImpersonate_LIBRARY)
